# Portable defaults: paths are resolved from the folder containing compose.yaml.
OPENET2_REPORT_ROOT=.
OPENET2_REPORT_PORT=8080

# The included synthetic input is mounted read-only; generated files stay under
# outputs. Replace OPENET2_DATA_ROOT with an absolute host path only when
# analysing an external dataset. Windows paths may use forward slashes.
OPENET2_DATA_ROOT=./examples/synthetic_longitudinal_data
OPENET2_OUTPUT_ROOT=./outputs
